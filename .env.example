SECRET_KEY=
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matorral"
REDIS_URL="redis://localhost:6379"

GOOGLE_ANALYTICS_ID=""
SENTRY_DSN=""

USE_S3_MEDIA=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=

GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# WARNING: Disable this in production
ENABLE_DEBUG_TOOLBAR=True

# Host used to build absolute links in emails. MUST be the real, user-reachable
# host — links in email cannot be derived from a request. After changing this,
# run `manage.py configure_site` (or `migrate` on a fresh database).
SITE_DOMAIN="localhost:8000"
SITE_NAME="Siresoft"

# --- Email ---
# With no EMAIL_BACKEND set, emails print to the console and nothing is delivered.
# Uncomment below to send real mail over SMTP.
#
# EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
# EMAIL_HOST=mail.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL="Siresoft <noreply@example.com>"
# SERVER_EMAIL="Siresoft <noreply@example.com>"
#
# Or via Mailgun (django-anymail is already installed):
# EMAIL_BACKEND="anymail.backends.mailgun.EmailBackend"
# MAILGUN_API_KEY="key-***"
# MAILGUN_SENDER_DOMAIN="example.com"

# Comma-separated addresses that receive unhandled-exception mail.
ADMINS=

# Master switch for notification emails; set False to silence them all.
NOTIFICATIONS_ENABLED=True

# Copy every notification and invitation email to these addresses (comma-separated).
# Leave empty to disable. Mode is "bcc" (hidden, recommended) or "cc" (visible).
NOTIFICATION_COPY_TO=
NOTIFICATION_COPY_MODE=bcc

HEALTH_CHECK_TOKENS=

ACCOUNT_ALLOW_SIGNUPS=True

# --- Production (see deploy/) ---
# Must be explicitly False here. settings.py computes its own DEBUG default
# (True) and, while still executing that module, conditionally inserts
# "daphne" into INSTALLED_APPS if it's True — production.py's later
# `DEBUG = False` doesn't undo that, since by then INSTALLED_APPS is already
# built. daphne isn't installed in the prod dependency group, so leaving
# this unset crashes every management command with
# "ModuleNotFoundError: No module named 'daphne'".
DEBUG=False

# Public domain/IP nginx serves as server_name (plain HTTP — no TLS here).
DOMAIN=

# This deployment serves plain HTTP (no SSL termination anywhere in front
# of it). Keep this False — the default True would mark cookies Secure,
# which browsers silently drop over HTTP, breaking login/CSRF.
SECURE_SSL_REDIRECT=False

# Once HTTPS is back in front of the site, also set these (comma-separated,
# no spaces) — otherwise ALLOWED_HOSTS defaults to "*" (fine for HTTP, but
# not for production HTTPS) and CSRF_TRUSTED_ORIGINS defaults to empty,
# which fails the browser's Origin check on every login/form POST:
# ALLOWED_HOSTS=pmt.siresoft.net
# CSRF_TRUSTED_ORIGINS=https://pmt.siresoft.net
