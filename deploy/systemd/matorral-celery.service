[Unit]
Description=Matorral Celery worker + beat
# Service names shown are for RHEL/CentOS (PGDG postgresql17 package + the
# stock `redis` package). On Debian/Ubuntu these are `postgresql.service`
# and `redis-server.service` instead — adjust to match your distro.
After=network.target postgresql-17.service redis.service
Wants=postgresql-17.service redis.service

[Service]
Type=simple
User=matorral
Group=matorral
WorkingDirectory=/opt/matorral
EnvironmentFile=/opt/matorral/.env
Environment=DJANGO_SETTINGS_MODULE=matorral.settings.production
ExecStart=/opt/matorral/.venv/bin/celery -A matorral worker -l INFO --beat --pool=prefork --concurrency=2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
